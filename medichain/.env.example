# This is an EXAMPLE file. Copy this to .env and fill in your actual values.
# NEVER commit .env to GitHub - it contains sensitive information!

# ┌─────────────────────────────────────────────────────────────┐
# │ DJANGO SETTINGS                                             │
# └─────────────────────────────────────────────────────────────┘

SECRET_KEY=your-secret-key-generate-with-get_random_secret_key()
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ┌─────────────────────────────────────────────────────────────┐
# │ DATABASE CONFIGURATION                                      │
# └─────────────────────────────────────────────────────────────┘

DB_ENGINE=django.db.backends.mysql
DB_NAME=medichain
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306

# ┌─────────────────────────────────────────────────────────────┐
# │ EMAIL CONFIGURATION (For OTP Sending)                       │
# └─────────────────────────────────────────────────────────────┘

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Gmail Configuration:
# 1. Enable 2-Factor Authentication on your Gmail account
# 2. Go to myaccount.google.com/apppasswords
# 3. Select "Mail" and "Windows Computer" (or your device)
# 4. Generate an App Password (16 characters)
# 5. Use that password below (not your Gmail password)

EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password-16-chars

# ┌─────────────────────────────────────────────────────────────┐
# │ ENCRYPTION KEYS                                             │
# └─────────────────────────────────────────────────────────────┘

# Generate with:
# from cryptography.fernet import Fernet
# print(Fernet.generate_key().decode())

FERNET_KEY=your-fernet-key-here

# ┌─────────────────────────────────────────────────────────────┐
# │ JWT TOKEN SETTINGS (Auto-managed by Django)                 │
# └─────────────────────────────────────────────────────────────┘

# Access token lifetime in hours
ACCESS_TOKEN_LIFETIME=8

# Refresh token lifetime in days
REFRESH_TOKEN_LIFETIME=7

# ┌─────────────────────────────────────────────────────────────┐
# │ APPLICATION-SPECIFIC SETTINGS                               │
# └─────────────────────────────────────────────────────────────┘

# OTP Expiry time in minutes
OTP_EXPIRY_TIME=10

# Maximum OTP attempts before locking
MAX_OTP_ATTEMPTS=5

# ┌─────────────────────────────────────────────────────────────┐
# │ SECURITY (Production Only)                                  │
# └─────────────────────────────────────────────────────────────┘

# Set to False in production
DEBUG=False

# Add your production domains
ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# HTTPS only
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
